# Copy to .env  (all optional for local dev)
SECRET_KEY=change-this-long-random-string
# (default is SQLite if unset)
DATABASE_URL=postgresql+psycopg2://p123:p123@localhost:5432/p123
# Email (password is emailed at signup). Gmail: use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# LLM (planner + explanation). Without a key the ML router + template explainer are used.
ANTHROPIC_API_KEY=
